# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
# Generate a high-entropy secret (32+ characters) for each deployed environment.
BETTER_AUTH_SECRET="replace-with-a-secure-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Storage
# Provider-specific variables are added when the ASR storage provider is selected.

# Payments — Pesapal API 3.0
# Keep merchant credentials server-side only. Use sandbox until Pesapal approves live credentials.
PESAPAL_ENV="sandbox"
PESAPAL_CONSUMER_KEY="replace-with-pesapal-consumer-key"
PESAPAL_CONSUMER_SECRET="replace-with-pesapal-consumer-secret"
# Optional: once registered, reuse a fixed IPN ID. If omitted, ASR registers its IPN automatically.
PESAPAL_IPN_ID=""
ASR_PREMIUM_PRICE_UGX="15000"
