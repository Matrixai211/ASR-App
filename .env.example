# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-secure-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ASR media storage — S3-compatible (Cloudflare R2, AWS S3, Backblaze B2, etc.)
S3_ENDPOINT="https://your-s3-compatible-endpoint"
S3_REGION="auto"
S3_BUCKET="asr-media"
S3_ACCESS_KEY_ID="replace-with-storage-access-key"
S3_SECRET_ACCESS_KEY="replace-with-storage-secret"
# Use "true" for providers that require path-style addressing.
S3_FORCE_PATH_STYLE="false"

# Payments — Pesapal API 3.0
PESAPAL_ENV="sandbox"
PESAPAL_CONSUMER_KEY="replace-with-pesapal-consumer-key"
PESAPAL_CONSUMER_SECRET="replace-with-pesapal-consumer-secret"
PESAPAL_IPN_ID=""
ASR_PREMIUM_PRICE_UGX="15000"
