# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
# Generate a high-entropy secret (32+ characters) for each deployed environment.
BETTER_AUTH_SECRET="replace-with-a-secure-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Storage
# Provider-specific variables are added when the ASR storage provider is selected.

# Payments — Flutterwave
# Keep these server-side only. Never expose the secret key or webhook hash to the browser.
FLW_SECRET_KEY="replace-with-flutterwave-secret-key"
FLW_SECRET_HASH="replace-with-random-webhook-secret"
ASR_PREMIUM_PRICE_UGX="replace-with-premium-price-in-ugx"
